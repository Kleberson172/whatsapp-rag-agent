# === Banco de dados ===
# Local: postgres://user:senha@localhost:5432/whatsapp_rag
# Pode reaproveitar a mesma instância Postgres do RotaFlow (schema separado)
DATABASE_URL=postgresql://neondb_owner:npg_CRzuxI1S9PBp@ep-purple-band-axg9oo5a-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
ANTHROPIC_API_KEY=sk-ant-...
# Haiku = mais barato, ótimo pra respostas diretas de atendimento.
# Troque pra claude-sonnet-4-6 se precisar de respostas mais elaboradas/complexas.
CLAUDE_MODEL=claude-haiku-4-5-20251001

# === Voyage AI - embeddings (recomendado pela Anthropic p/ RAG) ===
# https://www.voyageai.com/ - tem free tier generoso pra testar
VOYAGE_API_KEY=pa-...

# === Canal WhatsApp ===
# "meta" = Meta WhatsApp Cloud API direta (RECOMENDADO - sem taxa extra de plataforma)
# "twilio" = via Twilio (mais rápido pra testar no Sandbox, mas cobra taxa por mensagem)
WHATSAPP_PROVIDER=meta

# --- Meta WhatsApp Cloud API ---
# Criar em developers.facebook.com > seu app > WhatsApp > API Setup
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
# Token que você mesmo inventa (uma senha qualquer) - usado só na verificação do webhook
META_VERIFY_TOKEN=escolha-uma-senha-aqui

# --- Twilio (opcional, fallback para testes rápidos no Sandbox) ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# === Servidor ===
PORT=3000
# Nome da empresa (usado no prompt do agente)
BUSINESS_NAME="Perfumaria Essência"
